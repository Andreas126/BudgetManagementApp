<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="main-root"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.budgetmanagementapp.controller.MainController">

    <!-- Meniu Lateral (Side Menu) -->
    <left>
        <VBox spacing="15.0" styleClass="side-menu">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="30.0"/>
            </padding>
            <prefWidth>220</prefWidth>

            <!-- Titlu Aplicatie -->
            <Label text="Budget Insight" styleClass="side-menu-title">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
                <padding>
                    <Insets bottom="20.0"/>
                </padding>
            </Label>

            <!-- Butoane Navigare -->
            <Button fx:id="btnTranzactii" text="Tranzactii" onAction="#showTranzactiiView" styleClass="nav-btn"/>
            <Button fx:id="btnBuget" text="Buget si Recurente" onAction="#showBugetView" styleClass="nav-btn"/>

            <!-- Spacer pentru a impinge info utilizator si logout in jos -->
            <VBox VBox.vgrow="ALWAYS"/>

            <!-- Info Utilizator -->
            <VBox spacing="10.0" styleClass="user-section">
                <Label fx:id="userLabel" text="Utilizator: -" styleClass="user-info"/>
                <Button text="Deconectare" onAction="#onLogout" styleClass="btn-logout" prefWidth="190"/>
            </VBox>
        </VBox>
    </left>

    <!-- Zona principala de continut dinamic -->
    <center>
        <VBox fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="content-area"/>
    </center>

</BorderPane>
